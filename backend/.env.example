# ── Server ──────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=true

# ── Qdrant ──────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── Neo4j ───────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=codexmind

# ── Embedding (bge-m3) ───────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_LENGTH=1024

# ── Ollama / LLM (懒加载，低置信度时触发) ─────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b
OLLAMA_TIMEOUT=120
# 向量分低于此阈值时才触发 LLM query expansion
LLM_TRIGGER_THRESHOLD=0.55

# ── Code Indexer ─────────────────────────────────────
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=80
SUPPORTED_EXTENSIONS=.java,.ts,.js,.vue,.xml,.jsp

# ── BM25 ─────────────────────────────────────────────
BM25_INDEX_DIR=./data/bm25

# ── SQLite ───────────────────────────────────────────
SQLITE_PATH=./data/history.db

# ── Security ─────────────────────────────────────────
ALLOWED_REPO_ROOTS=
