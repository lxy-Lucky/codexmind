# ── Server ──────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=true

# ── Qdrant ──────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── Embedding (bge-m3) ──────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cuda          # cuda | cpu
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_LENGTH=512

# ── Ollama / LLM ────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:32b
OLLAMA_TIMEOUT=120

# ── Code Indexer ─────────────────────────────────────
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
# 支持的扩展名（逗号分隔）
SUPPORTED_EXTENSIONS=.java,.py,.ts,.js,.go,.kt,.scala,.rs,.cpp,.c,.cs

# ── SQLite (历史记录) ─────────────────────────────────
SQLITE_PATH=./data/history.db

# ── 允许注册的本地根路径前缀（安全白名单，逗号分隔）──────
# 留空表示不限制（仅在受信任环境使用）
ALLOWED_REPO_ROOTS=
